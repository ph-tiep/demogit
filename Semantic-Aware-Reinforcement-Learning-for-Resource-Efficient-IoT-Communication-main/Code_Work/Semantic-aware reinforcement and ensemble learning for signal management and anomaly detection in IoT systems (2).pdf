                  pdfaProperty:name="PlateNames"
                  pdfaProperty:valueType="Seq Text"/>
                <rdf:li
                  pdfaProperty:category="internal"
                  pdfaProperty:description="A structure containing the characteristics of a font used in a document"
                  pdfaProperty:name="Fonts"
                  pdfaProperty:valueType="Bag Font"/>
              </rdf:Seq>
            </pdfaSchema:property>
            <pdfaSchema:valueType>
